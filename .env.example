# LLM Provider Configuration
# ============================================
# Supported providers: openrouter (default), vllm, ollama, lm-studio
# Default: OpenRouter cloud model for easiest first-time setup
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=http://localhost:8000  # Needed only for local providers (vllm/ollama/lm-studio)
# LLM_TIMEOUT=120  # Timeout in seconds (config default: 120)
# LLM_STRIP_THINKING=true  # Strip <think> tags from reasoning model outputs
# VLLM_API_KEY=  # Only if your vLLM server requires auth (default: none)
#
# Hosted last-resort model (OpenRouter) used by the parse path AND the
# indicator selector when the configured provider fails at runtime (e.g. a
# local-LLM tunnel drops). Reasoning model; callers budget tokens accordingly.
# LLM_FALLBACK_MODEL=openai/gpt-oss-120b
#
# Dedicated indicator-selector endpoint (optional). When BOTH are set, the
# selector adjudicates candidates against this endpoint first (e.g. an
# SSH-tunneled local vLLM running a stronger model) and falls back to the
# main LLM automatically when the endpoint is down.
# SELECTOR_LLM_MODEL=gpt-oss-120b
# SELECTOR_LLM_BASE_URL=http://localhost:8000
#
# vLLM Configuration (local or SSH-tunneled servers)
# ============================================
# vLLM uses OpenAI-compatible API with reasoning_effort=low for efficiency
# Achieves 100% accuracy with ~2.7s response time per query
#
# For SSH-tunneled vLLM server:
# ssh -N -R 8000:localhost:8000 user@remote-gpu-server
# LLM_BASE_URL=http://localhost:8000
# LLM_PROVIDER=vllm
# LLM_MODEL=gpt-oss-120b
#
# Supported vLLM model families:
# - gpt-oss-*: GPT-OSS reasoning models
# - Qwen3-Thinking: Reasoning models with <think> tags
# - Qwen3-Instruct: Standard instruct models
# - DeepSeek-R1: DeepSeek reasoning models
#
# OpenRouter Configuration
# ============================================
# OpenRouter is the default in this file:
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# LLM_TIMEOUT=120
#
# Ollama Configuration (for local Ollama models)
# ============================================
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3
#
# LM-Studio Configuration
# ============================================
# LLM_PROVIDER=lm-studio
# LLM_BASE_URL=http://localhost:1234
# LLM_MODEL=local-model

# OpenRouter API Configuration (required for default setup)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI Embedding Configuration (optional)
# Only needed if you want OpenAI embeddings for vector search / semantic routing
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=org_your_openai_org_id

# Economic Data API Keys
# FRED API key (optional, but highly recommended for US economic data)
# Get your FRED API key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# UN Comtrade API key (optional, but recommended for international trade data)
# Register at: https://comtradedeveloper.un.org/
COMTRADE_API_KEY=your_comtrade_api_key_here

# CoinGecko API key (optional; raises rate limits for crypto price queries)
# Get one at: https://www.coingecko.com/en/api
# COINGECKO_API_KEY=your_coingecko_api_key_here

# ExchangeRate-API key (optional; the free open endpoint works without one)
# Get one at: https://www.exchangerate-api.com/
# EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Application Configuration
# JWT Secret for authentication (REQUIRED - generate with: openssl rand -hex 32)
# This has no default; the backend will not start without it.
# NOTE: When using Supabase, JWT validation uses Supabase's JWT secret
JWT_SECRET=your_jwt_secret_here
# JWT Token expiration in days (default: 7)
JWT_EXPIRES_DAYS=7

# CORS allowed origins (comma-separated list; no default — set explicitly)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Public base URL of the app (used in some links/redirects; default: https://data.openecon.ai)
# APP_URL=http://localhost:5173

# Environment configuration
NODE_ENV=development

# Mock-auth test user (only relevant when Supabase is NOT configured).
# In development/test mode a test user (test@example.com / testpass123) is
# created by default; set ALLOW_TEST_USER=false to disable it, or
# ALLOW_TEST_USER=true to force-enable it outside dev. Never enable in production.
# ALLOW_TEST_USER=true

# Free queries an anonymous (unregistered) visitor may run before the
# registration wall. Registered users are exempt. 0 = unlimited. (default: 20)
ANON_QUERY_LIMIT=20

# Anonymous-identity resolution mode for the free-query gate (default: shadow).
# - legacy:  original behavior only — key the quota on the frontend sessionId;
#            no anonymous session token is issued.
# - shadow:  keep the legacy gating decision UNCHANGED, but additionally
#            resolve + log the new token/IP-based identity and issue anonymous
#            session tokens (the X-OE-Session response header) so the scheme can
#            be measured before cutover.
# - enforce: RESERVED / not yet implemented — would gate on the resolved
#            identity itself.
# The anon session token's lifetime is a fixed code constant (90 days), not an
# env var, so there is nothing to configure here for it.
# ANON_IDENTITY_MODE=shadow

# Supabase Auth redirect URLs (must be in the Supabase Auth redirect allow list).
# Where Supabase sends users after they click the email-confirmation / reset links.
# EMAIL_CONFIRM_REDIRECT_URL=https://data.openecon.ai/chat?confirmed=1
# PASSWORD_RESET_REDIRECT_URL=https://data.openecon.ai/reset-password

# Trusted reverse-proxy source IPs whose X-Forwarded-For header is honored for
# client-IP attribution (rate limiting / anon gate). Comma-separated.
# Default: loopback only (Apache/nginx on the same host). Set this if a CDN/LB
# terminates TLS in front of the backend.
# TRUSTED_PROXIES=127.0.0.1,::1

# Server-side request deadlines (seconds). Beyond these, the request returns 504.
# QUERY_TIMEOUT_SECONDS=120        # /api/query and /api/query/stream (default: 120)
# PRO_QUERY_TIMEOUT_SECONDS=180    # /api/query/pro (default: 180)

# Conversation context expiration (Redis TTL + in-memory max age), in hours (default: 24)
# CONVERSATION_TTL_HOURS=24

# Feature flags
DISABLE_MCP=false
DISABLE_BACKGROUND_JOBS=false
USE_LANGCHAIN_ORCHESTRATOR=true
USE_INDICATOR_HYBRID_RERANK=true
INDICATOR_RRF_K=60
INDICATOR_VECTOR_CANDIDATES=40
USE_OUTCOME_DECISION_STAGE=false
USE_MINIMAL_EXECUTION_PLAN=false
USE_POST_FETCH_SEMANTIC_JUDGE=false
USE_STAGED_STATE_COMMIT=false

# Pro Mode Configuration (optional)
# ============================================
# SECURITY: Pro Mode executes AI-generated Python code
# WARNING: Only enable in development or with proper sandboxing (Docker isolation)
# Set to 'false' to completely disable Pro Mode code execution
# Default: false (disabled for security)
PROMODE_ENABLED=false
#
# These directories need to be accessible by both the backend and web server
#
# Public directory for Pro Mode generated files (charts, CSVs, etc.)
# - Development default: {project_root}/public_media/promode
# - Must be served by web server at /static/promode/
# - Production example: /home/hanlulong/OpenEcon/public_media/promode
# PROMODE_PUBLIC_DIR=/home/hanlulong/OpenEcon/public_media/promode
#
# Session storage directory for Pro Mode data persistence
# - Development default: {system_temp}/promode_sessions (e.g., /tmp/promode_sessions)
# - Production example: /tmp/promode_sessions or /var/lib/openecon/sessions
# PROMODE_SESSION_DIR=/tmp/promode_sessions
#
# Pro Mode code generation
# - When LLM_PROVIDER=vllm, code is generated by the local vLLM model (gpt-oss-120b);
#   otherwise it falls back to OpenRouter (OPENROUTER_API_KEY). There is no GROK_API_KEY/X.AI key.
# - Optional: set USE_LANGCHAIN_PROMODE=true to use the LangChain ReAct agent for code
#   generation instead of the default single-shot path (requires langchain extras to be
#   installed; LangChain is included in backend/requirements.txt).
# USE_LANGCHAIN_PROMODE=false

# Vector Search and Metadata Configuration
# ============================================
# Embedding model used for vector search and, by default, semantic provider routing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional OpenAI embedding setup:
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
#
# Enable metadata loading on startup (config default: true). Set false to skip
# the FAISS/metadata load for faster startup in lightweight/dev setups.
ENABLE_METADATA_LOADING=false
#
# Metadata loading timeout in seconds (config default: 60)
# Prevents startup from hanging if metadata loading is slow
METADATA_LOADING_TIMEOUT=30
#
# Use FAISS for vector search instead of ChromaDB (default: true)
# FAISS: 100x faster (<100ms load, <5ms search), uses ~200MB memory
# ChromaDB: More features, slower startup (5+ minutes), uses 500MB+ memory
USE_FAISS_INSTEAD_OF_CHROMA=true
#
# Directory to store FAISS index files (default: backend/data/faiss_index)
VECTOR_SEARCH_CACHE_DIR=backend/data/faiss_index

# Note: rate limiting is always on for remote IPs in production (per-endpoint
# limits are defined in backend/main.py) and bypassed for localhost/dev. The
# only env toggle is MCP_RATE_LIMIT_ENABLED (below), which gates the /mcp limits
# specifically; the /api/* limits have no env toggle. The backend reads no
# PORT/FRONTEND_URL/LOG_LEVEL/CACHE_TTL_* env vars; the dev port (3001) is set in
# package.json.
#
# Rate limiting for the MCP endpoint (default: enabled). When enabled, remote
# /mcp traffic is throttled — GET /mcp (SSE connection opens) at 12/minute and
# POST /mcp/messages* (JSON-RPC tool calls) at 30/minute; localhost/loopback
# stays exempt. Set to false/0/no/off to fully exempt /mcp from rate limiting.
# MCP_RATE_LIMIT_ENABLED=true
#
# Redis: optional. The backend connects to redis://localhost:6379/0 (not
# configurable via env vars) and falls back to in-memory caching if Redis is
# not running, so no Redis setup is required for local development.
